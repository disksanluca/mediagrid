{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "MediaGrid",
  "version": "0.1.0",
  "identifier": "com.mediagrid.desktop",
  "build": {
    "beforeDevCommand": "npm --prefix ../.. run dev --workspace @mediagrid/web -- --hostname 127.0.0.1 --port 3000",
    "devUrl": "http://127.0.0.1:3000",
    "beforeBuildCommand": "npm --prefix ../.. run build:desktop --workspace @mediagrid/web",
    "frontendDist": "../../web/out"
  },
  "app": {
    "windows": [
      {"label": "main", "title": "MediaGrid", "width": 1440, "height": 900, "minWidth": 1000, "minHeight": 660, "visible": false, "backgroundColor": "#0b1015"},
      {"label": "splash", "title": "MediaGrid", "url": "splash.html", "width": 520, "height": 330, "center": true, "resizable": false, "decorations": false, "alwaysOnTop": true, "backgroundColor": "#0b1015"}
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data: blob:; style-src 'self' 'unsafe-inline'; script-src 'self'; connect-src ipc: http://ipc.localhost http://127.0.0.1:*; font-src 'self' data:"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/icon.ico"],
    "externalBin": ["binaries/mediagrid-service"]
  }
}
