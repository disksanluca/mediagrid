MEDIAGRID_MODE=LOCAL
ALLOW_PAID_AI=false
DATABASE_URL=sqlite:///./data/mediagrid.db
# CI-only PostgreSQL migration smoke uses a disposable localhost/mediagrid_ci
# database and MEDIAGRID_ALLOW_EPHEMERAL_PG_SMOKE=1. Never set it on a user DB.
# Schema revisions run on Core startup. The first upgrade of a legacy SQLite DB
# writes a pre-edl-v2 snapshot under MEDIAGRID_DATA_DIR/backups.
API_HOST=127.0.0.1
API_PORT=8000
WEB_PORT=3000
NEXT_PUBLIC_API_URL=/api/v1
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=llama3.2
# Optional offline transcription with whisper.cpp (otherwise Windows speech recognition is used).
# WHISPER_CLI_PATH=whisper-cli
# WHISPER_MODEL_PATH=C:/MediaGrid/models/ggml-base.bin
# Optional local faster-whisper 1.2.1 model directory for word timestamps.
# Runtime inference never downloads a model. Install with `uv sync --extra asr`.
# MEDIAGRID_ASR_MODEL_DIR=C:/MediaGrid/models/faster-whisper-base
# Own-voice import uses local FFmpeg and FFprobe, normally bundled with the desktop
# or available on PATH. Set both paths only for a custom development installation.
# MEDIAGRID_FFMPEG_PATH=C:/Tools/ffmpeg/bin/ffmpeg.exe
# MEDIAGRID_FFPROBE_PATH=C:/Tools/ffmpeg/bin/ffprobe.exe
# Optional official Blender 4.5 LTS executable for original 3D renders.
# MEDIAGRID_BLENDER_PATH=C:/Tools/blender-4.5.14-windows-x64/blender.exe
DRY_RUN=true
MEDIAGRID_DATA_DIR=./data
# Remotion local: máximo de abas de render (limitado também pelo número de CPUs).
# MEDIAGRID_RENDER_CONCURRENCY=4
# Future server migration only; leave these unset for local V1.
# MEDIAGRID_ADMIN_PASSWORD=
# MEDIAGRID_SESSION_SECRET=
# MEDIAGRID_PUBLIC_URL=https://your-domain.example
# Server mode is experimental until owner-scoped auth and remote worker leases are complete.
# MEDIAGRID_SERVER_EXPERIMENTAL=false
