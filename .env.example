MEDIAGRID_MODE=LOCAL
ALLOW_PAID_AI=false
DATABASE_URL=sqlite:///./data/mediagrid.db
API_HOST=127.0.0.1
API_PORT=8000
WEB_PORT=3000
NEXT_PUBLIC_API_URL=/api/v1
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=llama3.2
# Optional offline transcription with whisper.cpp (otherwise Windows speech recognition is used).
# WHISPER_CLI_PATH=whisper-cli
# WHISPER_MODEL_PATH=C:/MediaGrid/models/ggml-base.bin
DRY_RUN=true
MEDIAGRID_DATA_DIR=./data
# Future server migration only; leave these unset for local V1.
# MEDIAGRID_ADMIN_PASSWORD=
# MEDIAGRID_SESSION_SECRET=
# MEDIAGRID_PUBLIC_URL=https://your-domain.example
