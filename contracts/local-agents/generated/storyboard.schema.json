{
  "$defs": {
    "ShotIdea": {
      "additionalProperties": false,
      "properties": {
        "audio_cue": {
          "default": "",
          "maxLength": 160,
          "title": "Audio Cue",
          "type": "string"
        },
        "beat": {
          "maxLength": 240,
          "minLength": 3,
          "title": "Beat",
          "type": "string"
        },
        "camera_intent": {
          "maxLength": 160,
          "minLength": 2,
          "title": "Camera Intent",
          "type": "string"
        },
        "camera_move": {
          "enum": [
            "locked",
            "push_in",
            "pull_out",
            "pan",
            "tilt",
            "track",
            "handheld",
            "rack_focus"
          ],
          "title": "Camera Move",
          "type": "string"
        },
        "character_pose": {
          "maxLength": 160,
          "minLength": 3,
          "title": "Character Pose",
          "type": "string"
        },
        "environment_id": {
          "maxLength": 60,
          "minLength": 2,
          "title": "Environment Id",
          "type": "string"
        },
        "expression": {
          "maxLength": 120,
          "minLength": 3,
          "title": "Expression",
          "type": "string"
        },
        "interface_action": {
          "default": "",
          "maxLength": 200,
          "title": "Interface Action",
          "type": "string"
        },
        "motion_intent": {
          "maxLength": 160,
          "minLength": 2,
          "title": "Motion Intent",
          "type": "string"
        },
        "on_screen_text": {
          "default": "",
          "maxLength": 60,
          "title": "On Screen Text",
          "type": "string"
        },
        "sfx_cues": {
          "items": {
            "type": "string"
          },
          "maxItems": 8,
          "title": "Sfx Cues",
          "type": "array"
        },
        "shot_size": {
          "enum": [
            "establishing",
            "wide",
            "medium",
            "close_up",
            "extreme_close_up",
            "pov",
            "over_shoulder",
            "insert"
          ],
          "title": "Shot Size",
          "type": "string"
        },
        "visual_description": {
          "maxLength": 800,
          "minLength": 8,
          "title": "Visual Description",
          "type": "string"
        }
      },
      "required": [
        "beat",
        "visual_description",
        "camera_intent",
        "motion_intent",
        "environment_id",
        "shot_size",
        "camera_move",
        "character_pose",
        "expression"
      ],
      "title": "ShotIdea",
      "type": "object"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "local_shot_ideas_v1",
      "default": "local_shot_ideas_v1",
      "title": "Schema Version",
      "type": "string"
    },
    "shots": {
      "items": {
        "$ref": "#/$defs/ShotIdea"
      },
      "maxItems": 12,
      "minItems": 6,
      "title": "Shots",
      "type": "array"
    }
  },
  "required": [
    "shots"
  ],
  "title": "ShotIdeas",
  "type": "object"
}
